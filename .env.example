# Local Postgres started by docker compose, or any PostgreSQL 16 + PostGIS 3 database.
DATABASE_URL=postgresql://homescout:homescout@localhost:5432/homescout

# County adapter key. See pipeline/adapters/.
HOMESCOUT_REGION=westchester_ny

# Optional overrides. Defaults are <repo>/data and <repo>/dist.
# HOMESCOUT_DATA_DIR=/absolute/path/to/data
# HOMESCOUT_DIST_DIR=/absolute/path/to/dist
